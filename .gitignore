# Secrets and credentials
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*token*
*secret*
auth.json

# Codex runtime state; keep only checked-in rule files
.codex/*
!.codex/rules/
!.codex/rules/*.md

# Python and tooling
__pycache__/
*.egg-info/
.ruff_cache/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/
env/

# Node and frontend tooling
node_modules/
dist/
build/
.next/
.vite/

# Logs and local runtime output
*.log
logs/
tmp/
temp/
.cache/

# Agent worktrees
.claude/worktrees/

# Collected run data. dataset/ also carries its own .gitignore.
dataset/

# Measured test fixtures (images). The tests that use them skip loudly
# when absent -- see dev/tests/fixtures/README.md.
dev/tests/fixtures/*
!dev/tests/fixtures/README.md

# Lab data and large artifacts
#   Collected run data lives OUTSIDE the repo (config.yaml -> data.root,
#   default ~/sdl_data/runs) and carries its own .gitignore. These entries
#   catch anything that lands here by accident.
data/
datasets/
results/
runs/
artifacts/
test/images/*
!test/images/.gitkeep
!test/images/README.md
checkpoints/
models/
*.h5
*.hdf5
*.pt
*.pth
*.onnx
*.tif
*.tiff
*.nd2
*.czi
*.lif
*.avi
*.mp4
*.mov
*.zip
*.tar
*.tar.gz
*.7z
